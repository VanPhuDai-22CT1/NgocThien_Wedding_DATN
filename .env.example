# Copy to .env and fill with your local values
# Database
DB_NAME=ngocthienwedding
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Server
PORT=5000

# Frontend URL(s) for CORS and same-origin checks
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Optional
NODE_PATH=src

# Optional frontend bank details. Leave empty until verified by the business.
# Restart the frontend after changing REACT_APP_* values.
REACT_APP_BANK_BIN=
REACT_APP_BANK_NAME=
REACT_APP_BANK_ACCOUNT=
REACT_APP_BANK_ACCOUNT_NAME=
# Optional deposit percentage agreed by the business (1-100).
REACT_APP_BANK_DEPOSIT_PERCENT=

# OpenAI: server-side only. Never put API keys in REACT_APP_* variables.
# Add these settings to backend/.env when that file is used by the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_WEB_SEARCH=false
